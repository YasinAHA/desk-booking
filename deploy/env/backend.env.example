NODE_ENV=production
APP_VERSION=v0.8.0
PORT=3001
HOST=0.0.0.0

JWT_SECRET=change_me_in_production_use_strong_secret
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change_me_in_production_use_strong_secret
JWT_REFRESH_EXPIRATION=7d
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_REFRESH_COOKIE_DOMAIN=
JWT_ISSUER=desk-booking
JWT_AUDIENCE=desk-booking-api

ALLOWED_EMAIL_DOMAINS=camerfirma.com,gmail.com,outlook.com,hotmail.com,yahoo.com

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Desk Booking <no-reply@camerfirma.com>
EMAIL_MODE=fake

OUTBOX_POLL_INTERVAL_MS=3000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_BASE_MS=2000
OUTBOX_BACKOFF_MAX_MS=60000

APP_BASE_URL=https://deskbooking-yasin.duckdns.org
FRONTEND_BASE_URL=https://deskbooking-yasin.duckdns.org
CORS_ORIGINS=https://deskbooking-yasin.duckdns.org
